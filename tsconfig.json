{
  "extends": "@quasar/app-vite/tsconfig-preset",
  "compilerOptions": {
    "baseUrl": ".",
    // 覆寫 paths 需保留 preset 的別名；three 子路徑匯出（webgpu / tsl）需手動指向型別
    "paths": {
      "src/*": ["src/*"],
      "app/*": ["*"],
      "components/*": ["src/components/*"],
      "layouts/*": ["src/layouts/*"],
      "pages/*": ["src/pages/*"],
      "assets/*": ["src/assets/*"],
      "boot/*": ["src/boot/*"],
      "stores/*": ["src/stores/*"],
      "three/webgpu": ["node_modules/@types/three/build/three.webgpu.d.ts"],
      "three/tsl": ["node_modules/@types/three/build/three.tsl.d.ts"]
    }
  }
}
